# ==============================================================================
# Environment variables — copy to `.env.local` and fill in.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser. Never put a secret
# behind that prefix. Consumed exclusively through `config/env.ts`.
# ==============================================================================

# --- Site -------------------------------------------------------------------
# Canonical origin. Used for metadata, canonical URLs, sitemap.xml and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- API --------------------------------------------------------------------
# Base URL for the backend. "/api" uses this app's own route handlers.
NEXT_PUBLIC_API_BASE_URL=/api
# Server-only bearer token attached by lib/api/client.ts.
API_KEY=
API_TIMEOUT_MS=15000
API_RETRIES=2

# --- Assets -----------------------------------------------------------------
# CDN origin for images and media. Leave empty to serve from /public.
NEXT_PUBLIC_ASSET_BASE_URL=

# --- Integrations -----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# External scheduler (e.g. Zocdoc). Empty = use the built-in appointment form.
NEXT_PUBLIC_BOOKING_URL=

# --- Email ------------------------------------------------------------------
CONTACT_FORM_RECIPIENT=
SMTP_URL=

# --- Feature flags ----------------------------------------------------------
NEXT_PUBLIC_FEATURE_ANALYTICS=false
NEXT_PUBLIC_FEATURE_LIVE_CHAT=false
NEXT_PUBLIC_FEATURE_ONLINE_BOOKING=true
NEXT_PUBLIC_FEATURE_BLOG=false
